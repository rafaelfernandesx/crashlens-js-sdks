{
  "name": "@crashlensorg/core",
  "version": "0.2.0",
  "description": "CrashLens JS SDK — núcleo compartilhado (tipos, fingerprint, transport, fila, escopo, sessões)",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["crashlens", "error-monitoring", "crash-reporting", "sentry-alternative"],
  "homepage": "https://crashlens.laziv.com"
}