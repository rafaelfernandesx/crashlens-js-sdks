{
  "name": "@crashlensorg/nestjs",
  "version": "0.2.0",
  "description": "CrashLens integração com NestJS — módulo, filtro global de exceções e interceptor HTTP",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @nestjs/common --external @nestjs/core --external @nestjs/platform-express --external @nestjs/websockets --external @nestjs/microservices --external rxjs --external reflect-metadata",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crashlensorg/node": "0.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "keywords": ["crashlens", "nestjs", "error-monitoring", "crash-reporting", "sentry-alternative"]
}