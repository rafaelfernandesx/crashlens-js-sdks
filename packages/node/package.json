{
  "name": "@crashlensorg/node",
  "version": "0.3.0",
  "description": "CrashLens SDK para Node.js — captura de exceções, rejeições não tratadas e contexto HTTP",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crashlensorg/core": "0.3.0"
  },
  "keywords": ["crashlens", "nodejs", "error-monitoring", "crash-reporting", "sentry-alternative"]
}